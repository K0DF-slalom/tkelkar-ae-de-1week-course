# Spark Dockerfile optimized for Apple Silicon (ARM64)
# Custom build with Python 3.12+ and Spark 4.0.1

FROM python:3.12-slim

# Switch to root for installations
USER root

# System dependencies for Spark + Java
RUN apt-get update && apt-get install -y \
    openjdk-21-jre-headless \
    curl \
    bash \
    procps \
    netcat-openbsd \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Spark 4.0.1 (Hadoop 3)
ENV SPARK_VERSION=4.0.1
ENV HADOOP_PROFILE=hadoop3
RUN curl -fL -o /tmp/spark.tgz \
    https://archive.apache.org/dist/spark/spark-${SPARK_VERSION}/spark-${SPARK_VERSION}-bin-${HADOOP_PROFILE}.tgz \
    && tar -xzf /tmp/spark.tgz -C /opt \
    && mv /opt/spark-${SPARK_VERSION}-bin-${HADOOP_PROFILE} /opt/spark \
    && rm -f /tmp/spark.tgz

# Install Python dependencies
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Download PostgreSQL JDBC driver
RUN curl -L -o /opt/spark/jars/postgresql-42.7.1.jar \
    https://jdbc.postgresql.org/download/postgresql-42.7.1.jar

# Create application directories
RUN mkdir -p /app/src /app/data/input /app/scripts

# Set working directory
WORKDIR /app

# Set environment variables for Spark
ENV SPARK_HOME=/opt/spark
ENV PATH=$PATH:$SPARK_HOME/bin:$SPARK_HOME/sbin
ENV PYSPARK_PYTHON=python3
ENV PYSPARK_DRIVER_PYTHON=python3

# Expose necessary ports
EXPOSE 8080 7077 4040 8081 9999 3333

# Default entrypoint for MCP server
ENTRYPOINT ["python3", "/app/src/mcp_server.py"]
